# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
# 호스트 포트가 다른 프로그램과 겹칠 때만 바꾼다. 컨테이너 안 포트는 고정이다.
WEB_PORT=8000
SECURITY_PORT=8001
STREAM_PORT=8002
VISION_PORT=8003
GESTURE_PORT=8004
HTTPS_PORT=443
HTTP_PORT=80

# 휴대폰이 접속할 PC 내부 IP (ipconfig의 IPv4 주소). security가 이 주소로 HTTPS 인증서와 QR 주소를 만든다.
# 바꾼 뒤에는 services/security/certs/의 cert.pem·key.pem을 지우고 security를 다시 띄운다.
SECURITY_CERT_HOST=192.168.0.12
